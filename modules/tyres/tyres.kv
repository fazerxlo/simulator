<Tyres>:
  ScrollView:
    do_scroll_x: False
    do_scroll_y: True
    BoxLayout:
      orientation: 'vertical'
      padding: 10
      spacing: 8
      size_hint_y: None
      height: self.minimum_height

      # --- Section 1: RT4 Warning Popups (0x1A1) ---
      BoxLayout:
        orientation: 'vertical'
        spacing: 4
        size_hint_y: None
        height: 90

        Label:
          text: 'RT4 Popup Alerts (0x1A1)'
          font_size: '14sp'
          bold: True
          size_hint_y: None
          height: 24

        GridLayout:
          cols: 3
          spacing: 6
          size_hint_y: None
          height: 64

          Button:
            text: 'OK (0x00)'
            on_release: root.send_tyre_message('ok')
          Button:
            text: 'Low Pressure (0x8D)'
            on_release: root.send_tyre_message('low_pressure')
          Button:
            text: 'Not Monitored (0xE5)'
            on_release: root.send_tyre_message('not_monitored')
          Button:
            text: 'Punctured (0x0D)'
            on_release: root.send_tyre_message('flat_tire')
          Button:
            text: 'High Speed (0xE7)'
            on_release: root.send_tyre_message('high_speed')
          Button:
            text: 'Underinflated (0xE8)'
            on_release: root.send_tyre_message('underinflated')

      # --- Section 3: 5-Wheel TPMS Status & Pressures (0x361 / 0x1E1 / 0x3A1) ---
      Label:
        text: 'Wheel Status & Pressures (0x361 / 0x1E1 / 0x3A1)'
        font_size: '14sp'
        bold: True
        size_hint_y: None
        height: 24

      GridLayout:
        cols: 2
        spacing: 12
        size_hint_y: None
        height: 320

        # Front Left
        BoxLayout:
          orientation: 'vertical'
          spacing: 3
          canvas.before:
            Color:
              rgba: 0.15, 0.15, 0.15, 0.6
            Rectangle:
              pos: self.pos
              size: self.size
          padding: 6
          Label:
            text: 'Front Left'
            font_size: '13sp'
            bold: True
            size_hint_y: None
            height: 20
          BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 30
            Label:
              id: state_fl
              text: 'OK'
              font_size: '14sp'
              bold: True
              color: 0, 1, 0, 1
              size_hint_x: 0.4
            Spinner:
              id: spinner_fl
              text: 'OK'
              values: ['OK', 'LOW', 'FLAT', 'NO DATA', 'BATTERY LOW']
              on_text: root.on_state_change('fl', self.text)
              size_hint_x: 0.6
          Label:
            id: cur_pressure_fl
            text: '2.40 bar'
            font_size: '12sp'
            size_hint_y: None
            height: 18
          Slider:
            id: slider_pressure_fl
            min: 0.0
            max: 4.0
            step: 0.05
            value: 2.4
            on_value: root.on_pressure_change('fl', args[1])
            size_hint_y: None
            height: 32

        # Front Right
        BoxLayout:
          orientation: 'vertical'
          spacing: 3
          canvas.before:
            Color:
              rgba: 0.15, 0.15, 0.15, 0.6
            Rectangle:
              pos: self.pos
              size: self.size
          padding: 6
          Label:
            text: 'Front Right'
            font_size: '13sp'
            bold: True
            size_hint_y: None
            height: 20
          BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 30
            Label:
              id: state_fr
              text: 'OK'
              font_size: '14sp'
              bold: True
              color: 0, 1, 0, 1
              size_hint_x: 0.4
            Spinner:
              id: spinner_fr
              text: 'OK'
              values: ['OK', 'LOW', 'FLAT', 'NO DATA', 'BATTERY LOW']
              on_text: root.on_state_change('fr', self.text)
              size_hint_x: 0.6
          Label:
            id: cur_pressure_fr
            text: '2.40 bar'
            font_size: '12sp'
            size_hint_y: None
            height: 18
          Slider:
            id: slider_pressure_fr
            min: 0.0
            max: 4.0
            step: 0.05
            value: 2.4
            on_value: root.on_pressure_change('fr', args[1])
            size_hint_y: None
            height: 32

        # Rear Left
        BoxLayout:
          orientation: 'vertical'
          spacing: 3
          canvas.before:
            Color:
              rgba: 0.15, 0.15, 0.15, 0.6
            Rectangle:
              pos: self.pos
              size: self.size
          padding: 6
          Label:
            text: 'Rear Left'
            font_size: '13sp'
            bold: True
            size_hint_y: None
            height: 20
          BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 30
            Label:
              id: state_rl
              text: 'OK'
              font_size: '14sp'
              bold: True
              color: 0, 1, 0, 1
              size_hint_x: 0.4
            Spinner:
              id: spinner_rl
              text: 'OK'
              values: ['OK', 'LOW', 'FLAT', 'NO DATA', 'BATTERY LOW']
              on_text: root.on_state_change('rl', self.text)
              size_hint_x: 0.6
          Label:
            id: cur_pressure_rl
            text: '2.20 bar'
            font_size: '12sp'
            size_hint_y: None
            height: 18
          Slider:
            id: slider_pressure_rl
            min: 0.0
            max: 4.0
            step: 0.05
            value: 2.2
            on_value: root.on_pressure_change('rl', args[1])
            size_hint_y: None
            height: 32

        # Rear Right
        BoxLayout:
          orientation: 'vertical'
          spacing: 3
          canvas.before:
            Color:
              rgba: 0.15, 0.15, 0.15, 0.6
            Rectangle:
              pos: self.pos
              size: self.size
          padding: 6
          Label:
            text: 'Rear Right'
            font_size: '13sp'
            bold: True
            size_hint_y: None
            height: 20
          BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 30
            Label:
              id: state_rr
              text: 'OK'
              font_size: '14sp'
              bold: True
              color: 0, 1, 0, 1
              size_hint_x: 0.4
            Spinner:
              id: spinner_rr
              text: 'OK'
              values: ['OK', 'LOW', 'FLAT', 'NO DATA', 'BATTERY LOW']
              on_text: root.on_state_change('rr', self.text)
              size_hint_x: 0.6
          Label:
            id: cur_pressure_rr
            text: '2.20 bar'
            font_size: '12sp'
            size_hint_y: None
            height: 18
          Slider:
            id: slider_pressure_rr
            min: 0.0
            max: 4.0
            step: 0.05
            value: 2.2
            on_value: root.on_pressure_change('rr', args[1])
            size_hint_y: None
            height: 32

      # Spare Wheel (Row)
      BoxLayout:
        orientation: 'horizontal'
        spacing: 10
        size_hint_y: None
        height: 44
        canvas.before:
          Color:
            rgba: 0.15, 0.15, 0.15, 0.6
          Rectangle:
            pos: self.pos
            size: self.size
        padding: 6

        Label:
          text: 'Spare Wheel'
          font_size: '13sp'
          bold: True
          size_hint_x: 0.3
        Label:
          id: state_spare
          text: 'OK'
          font_size: '14sp'
          bold: True
          color: 0, 1, 0, 1
          size_hint_x: 0.3
        Spinner:
          id: spinner_spare
          text: 'OK'
          values: ['OK', 'LOW', 'FLAT', 'NO DATA', 'BATTERY LOW']
          on_text: root.on_state_change('spare', self.text)
          size_hint_x: 0.4

      # --- Section 4: TPMS System State (0x1E1 Byte 5) ---
      Label:
        text: 'TPMS System Configuration (0x1E1 Byte 5)'
        font_size: '14sp'
        bold: True
        size_hint_y: None
        height: 24

      BoxLayout:
        orientation: 'horizontal'
        spacing: 10
        size_hint_y: None
        height: 38

        ToggleButton:
          id: btn_calib
          text: 'Calibration Mode (0x20)'
          state: 'down'
          on_state: root.on_system_toggle('calibration', self.state)
        ToggleButton:
          id: btn_fault
          text: 'System Fault (0x80)'
          state: 'normal'
          on_state: root.on_system_toggle('fault', self.state)
