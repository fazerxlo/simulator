<Buttons>:
  BoxLayout:
    orientation: 'vertical'
    padding: '8dp'
    spacing: '8dp'

    BoxLayout:
      size_hint_y: None
      height: '36dp'
      Label:
        text: 'Pressed keys:'
        size_hint_x: 0.3
      Label:
        id: pressed_keys
        text: '-'

    GridLayout:
      cols: 3
      spacing: '6dp'
      row_default_height: '44dp'
      row_force_default: True

      Button:
        id: btn_volume_up
        text: 'Volume +'
        on_press: root.pulse_volume('up')
      Button:
        id: btn_source
        text: 'Source'
        on_press: root.press_key('source')
      Button:
        id: btn_next
        text: 'Next'
        on_press: root.press_key('next')

      Button:
        id: btn_volume_down
        text: 'Volume -'
        on_press: root.pulse_volume('down')
      Label:
        text: ''
      Button:
        id: btn_prev
        text: 'Prev'
        on_press: root.press_key('prev')
